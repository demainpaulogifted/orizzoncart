# ============================================
# ORIZZONCART ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in the real values
# NEVER put real secrets in this file

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=orizzoncart.name.ng

# Platform Payment (OrizzonCart / OrizzonS Inc.)
PLATFORM_PAYSTACK_PUBLIC_KEY=
PLATFORM_PAYSTACK_SECRET_KEY=
PLATFORM_FLUTTERWAVE_PUBLIC_KEY=
PLATFORM_FLUTTERWAVE_SECRET_KEY=